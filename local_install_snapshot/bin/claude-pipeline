#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: claude-pipeline \"<requirement>\" [target_project_dir]"
  echo ""
  echo "Routes work through: Plan=Claude Opus 4.7, Exec=GPT-5.5, Audit=GPT-5.5"
  exit 1
}

if [[ $# -lt 1 ]]; then
  usage
fi

REQUIREMENT="$1"
TARGET_DIR="${2:-$(pwd)}"

exec /Users/frank/pipeline/pipeline.sh "$REQUIREMENT" "$TARGET_DIR"
