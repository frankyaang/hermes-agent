# ── Model configuration ────────────────────────────────────────
PLAN_MODEL="claude-opus-4-7"       # Claude: planning & decomposition
EXEC_MODEL="gpt-5.5"               # Codex: task execution (single bundled call)
AUDIT_MODEL="gpt-5.5"              # Codex: audit & verification

# ── Reasoning effort (low | medium | high | xhigh) ────────────
EXEC_REASONING="xhigh"            # execution: max accuracy for coding tasks
AUDIT_REASONING="high"            # audit: reading + judging

# ── Execution configuration ────────────────────────────────────
SANDBOX_MODE="workspace-write"     # read-only | workspace-write | danger-full-access
MAX_RETRIES=3                      # max plan→exec→audit cycles before giving up
